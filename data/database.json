    },
    {
      "id": "seed-8",
      "userId": "user-oslo-64",
      "text": "پس از فقدان عزیزی نزدیک، بعدازظهرهای ساده و معمولی بسیار گرانبهاتر از بزرگ‌ترین برنامه‌ها و رؤیاها شدند.",
      "context": "پس از دست دادن برادر جوان‌ترم در زمستان ۲۰۲۲.",
      "topics": [
        "Loss",
        "Time",
        "Life"
      ],
      "status": "published",
      "isCurrent": true,
